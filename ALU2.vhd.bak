library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.STD_LOGIC_UNSIGNED.ALL;
use IEEE.NUMERIC_STD.ALL;

entity ALU2 is
    port(
        Clock:         in std_logic;           -- Input clock signal
        A, B:          in unsigned(7 downto 0);-- 8-bit inputs from latches A and B
        student_id:    in unsigned(3 downto 0);-- 4-bit student id from FSM
        OP:            in unsigned(15 downto 0);-- 16-bit selector for Operation from Decoder
        Neg:           out std_logic;          -- Is the result negative? Set -ve bit output
        R1:            out unsigned(3 downto 0); -- Lower 4 bits of 8-bit Result Output
        R2:            out unsigned(3 downto 0)  -- Higher 4 bits of 8-bit Result Output
    );
end ALU2;

architecture calculation of ALU2 is
    signal Reg1, Reg2, Result: unsigned(7 downto 0) := (others => '0');
    signal Reg4: unsigned(0 to 7);
begin
    Reg1 <= A;  -- Temporarily store A in Reg1 local variable
    Reg2 <= B;  -- Temporarily store B in Reg2 local variable
   
    process(Clock, OP)
    begin
        case OP is
            WHEN "0000000000000001" => -- Function 1: Decrement B by 9
                Result <= Reg2 - 9;
                Neg <= '0';
               
            WHEN "0000000000000010" => -- Function 2: Swap lower and upper 4 bits of B
                Result <= (Reg2(3 downto 0) & Reg2(7 downto 4));
                Neg <= '0';

            WHEN "0000000000000100" => -- Function 3: Shift A to left by 2 bits
                Result <= Reg1(5 downto 0) & "00";
                Neg <= '0';

            WHEN "0000000000001000" => -- Function 4: Produce the result of NANDing A and B
                Result <= NOT(Reg1 AND Reg2);
                Neg <= '0';

            WHEN "0000000000010000" => -- Function 5: Find the greater value of A and B (Max(A,B))
                if Reg1 > Reg2 then
                    Result <= Reg1;
                else
                    Result <= Reg2;
                end if;
                Neg <= '0';

            WHEN "0000000000100000" => -- Function 6: Invert the even bits of B
                Reg4(0) <= Reg2(0);
                Reg4(1) <= NOT(Reg2(1)); -- Inverting even bits
                Reg4(2) <= Reg2(2);
                Reg4(3) <= NOT(Reg2(3));
                Reg4(4) <= Reg2(4);
                Reg4(5) <= NOT(Reg2(5));
                Reg4(6) <= Reg2(6);
                Reg4(7) <= NOT(Reg2(7));
                Result <= Reg4;
                Neg <= '0';

            WHEN "0000000001000000" => -- Function 7: Produce null on the output
                Result <= (others => '0');
                Neg <= '0';

            WHEN "0000000010000000" => -- Function 8: Replace upper four bits of B with upper four bits of A
                Result <= (Reg1(7 downto 4) & Reg2(3 downto 0));
                Neg <= '0';

            WHEN "0000000100000000" => -- Function 9: Show A on the output
                Result <= Reg1;
                Neg <= '0';

            WHEN OTHERS => -- Default: Do nothing
                Result <= (others => '0');
                Neg <= '0';
        end case;
    end process;
   
    R1 <= Result(3 downto 0); -- Lower 4-bits of the result
    R2 <= Result(7 downto 4); -- Upper 4-bits of the result
end calculation;
